{
  "name": "astra-refactored-workspace",
  "version": "0.0.0-p1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.7.0"
  },
  "description": "P1 offline local workspace for the Astra TS five-module rewrite. Mock-only development prototype; not a published package.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:ts": "node node_modules/typescript/bin/tsc -b && node --test packages/protocol/dist/tests/*.test.js apps/stdio-runtime/dist/tests/*.test.js"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.20.0"
  }
}
