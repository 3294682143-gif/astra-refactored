{
  "$defs": {
    "MetricsDto": {
      "description": "运行指标快照.",
      "properties": {
        "client_method_calls": {
          "default": 0,
          "title": "Client Method Calls",
          "type": "integer"
        },
        "logical_model_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Model Calls"
        },
        "effect_calls": {
          "default": 0,
          "title": "Effect Calls",
          "type": "integer"
        },
        "review_calls": {
          "default": 0,
          "title": "Review Calls",
          "type": "integer"
        },
        "catalog_calls": {
          "default": 0,
          "title": "Catalog Calls",
          "type": "integer"
        },
        "method_loads": {
          "default": 0,
          "title": "Method Loads",
          "type": "integer"
        },
        "asset_calls": {
          "default": 0,
          "title": "Asset Calls",
          "type": "integer"
        },
        "work_units": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Units"
        },
        "frames": {
          "default": 0,
          "title": "Frames",
          "type": "integer"
        },
        "remote_outcome_unknown": {
          "default": false,
          "title": "Remote Outcome Unknown",
          "type": "boolean"
        },
        "known_http_attempts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Http Attempts"
        },
        "reported_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Tokens"
        },
        "unknown_usage_requests": {
          "default": 0,
          "title": "Unknown Usage Requests",
          "type": "integer"
        }
      },
      "title": "MetricsDto",
      "type": "object"
    },
    "TraceRowDto": {
      "description": "单条 trace 记录.",
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "ts_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ts Ms"
        }
      },
      "required": [
        "seq",
        "kind",
        "id",
        "state",
        "code"
      ],
      "title": "TraceRowDto",
      "type": "object"
    }
  },
  "description": "solve() 公开返回对象的 Web 契约投影.",
  "properties": {
    "engine": {
      "default": "ts",
      "title": "Engine",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "final_response": {
      "default": "",
      "title": "Final Response",
      "type": "string"
    },
    "candidate_verified": {
      "const": false,
      "default": false,
      "title": "Candidate Verified",
      "type": "boolean"
    },
    "strictAcceptance": {
      "default": "NOT_PERFORMED",
      "title": "Strictacceptance",
      "type": "string"
    },
    "mode": {
      "default": "TS_PREVIEW",
      "title": "Mode",
      "type": "string"
    },
    "targetEnvironment": {
      "default": "TARGET_UNVERIFIED",
      "title": "Targetenvironment",
      "type": "string"
    },
    "stopReason": {
      "title": "Stopreason",
      "type": "string"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "unresolvedObligations": {
      "items": {
        "type": "string"
      },
      "title": "Unresolvedobligations",
      "type": "array"
    },
    "carrier": {
      "default": "",
      "title": "Carrier",
      "type": "string"
    },
    "sessionId": {
      "default": "",
      "title": "Sessionid",
      "type": "string"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/TraceRowDto"
      },
      "title": "Trace",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/MetricsDto"
    },
    "finishReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finishreason"
    },
    "childReaped": {
      "default": true,
      "title": "Childreaped",
      "type": "boolean"
    },
    "elapsedMs": {
      "default": 0,
      "title": "Elapsedms",
      "type": "integer"
    },
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    }
  },
  "required": [
    "status",
    "stopReason"
  ],
  "title": "SolveResultDto",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-version": "1.0.0"
}
