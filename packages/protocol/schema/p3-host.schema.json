{
  "format": "astra-p3-host-manifest-v1",
  "schemaDialect": "astra-p0-schema-subset-v1",
  "title": "Astra P3 local Host<->Node protocol manifest",
  "description": "Single normative field specification for the P3 local Host<->Node NDJSON channel. Local prototype: fixture model only, no real provider, no network, no arbitrary code. Protocol version is fixed to 1.1-p3-host-local. Byte limits and business binding checks are enforced by the host handlers, not by this manifest.",
  "protocolVersion": "1.1-p3-host-local",
  "limits": {
    "maxFrameBytes": 65536,
    "maxFramesPerSession": 1024,
    "maxDepth": 24,
    "maxSafeInteger": 9007199254740991,
    "maxIdChars": 128,
    "maxSessionIdChars": 128
  },
  "envelopes": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": { "type": "object" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "result": { "type": "object" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "message": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  },
  "methods": {
    "runtime.initialize": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "remainingMs", "maxModelCalls", "maxEffects", "maxMethodLoads", "maxTokens", "mode"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "remainingMs": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "maxModelCalls": { "type": "integer", "minimum": 0, "maximum": 3 },
          "maxEffects": { "type": "integer", "minimum": 0, "maximum": 2 },
          "maxMethodLoads": { "type": "integer", "minimum": 0, "maximum": 4 },
          "maxTokens": { "type": "integer", "const": 8192 },
          "mode": { "type": "string", "const": "MOCK_ONLY" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "mode", "targetEnvironment"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mode": { "type": "string", "const": "MOCK_ONLY" },
          "targetEnvironment": { "type": "string", "const": "TARGET_UNVERIFIED" }
        }
      }
    },
    "session.solve": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "problem", "problemHash"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "problem": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "mode", "targetEnvironment", "status", "finalResponse", "candidateVerified", "strictAcceptance", "modelCalls", "effectCalls", "cachedEffects", "catalogCalls", "methodLoads", "candidateRequestId", "contextHash", "stopReason"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mode": { "type": "string", "const": "MOCK_ONLY" },
          "targetEnvironment": { "type": "string", "const": "TARGET_UNVERIFIED" },
          "status": { "type": "string", "enum": ["candidate", "unsolved"] },
          "finalResponse": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "candidateVerified": { "type": "boolean", "const": false },
          "strictAcceptance": { "type": "string", "const": "NOT_PERFORMED" },
          "modelCalls": { "type": "integer", "minimum": 0, "maximum": 3 },
          "effectCalls": { "type": "integer", "minimum": 0, "maximum": 6 },
          "cachedEffects": { "type": "integer", "minimum": 0, "maximum": 2 },
          "catalogCalls": { "type": "integer", "minimum": 0, "maximum": 1 },
          "methodLoads": { "type": "integer", "minimum": 0, "maximum": 4 },
          "candidateRequestId": { "type": ["string", "null"], "enum": [null, "model-1", "model-2", "model-3"] },
          "contextHash": { "type": ["string", "null"], "minLength": 64, "maxLength": 64 },
          "stopReason": {
            "type": "string",
            "enum": ["FINAL", "UNSOLVED", "FIXTURE_EXHAUSTED", "BUDGET_EXHAUSTED", "TRANSPORT_STOP", "ACTION_REJECTED", "EFFECT_UNAVAILABLE", "EFFECT_UNKNOWN", "DEADLINE_EXCEEDED", "CONTEXT_REJECTED"]
          }
        }
      }
    },
    "session.stop": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "stopped"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "stopped": { "type": "boolean", "const": true }
        }
      }
    },
    "model.generate": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "requestId", "problemHash", "contractVersion", "taskId", "scopeId", "messages", "contextHash", "maxTokens", "temperature"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] },
          "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "contractVersion": { "type": "integer", "const": 1 },
          "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "scopeId": { "type": "string", "minLength": 64, "maxLength": 64 },
          "messages": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["system", "user"] },
                "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
              }
            }
          },
          "contextHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "maxTokens": { "type": "integer", "const": 8192 },
          "temperature": { "type": "string", "const": "0.2" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "requestId", "mode", "deliveryStatus", "text", "remainingMs"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] },
          "mode": { "type": "string", "const": "MOCK_ONLY" },
          "deliveryStatus": { "type": "string", "enum": ["COMPLETE", "TRUNCATED", "ERROR", "UNKNOWN"] },
          "text": { "type": "string", "maxLength": 20000 },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
        }
      }
    },
    "tool.execute": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "request"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effectId", "binding", "action", "remainingMs"],
            "properties": {
              "effectId": { "type": "string", "enum": ["effect-1", "effect-2", "effect-3", "effect-4", "effect-5", "effect-6"] },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sessionId", "problemHash", "contractVersion", "taskId", "scopeId", "sourceRequestId"],
                "properties": {
                  "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "contractVersion": { "type": "integer", "const": 1 },
                  "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "scopeId": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "sourceRequestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] }
                }
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action", "name", "args", "scope"],
                "properties": {
                  "action": { "type": "string", "const": "tool" },
                  "name": { "type": "string", "enum": ["polynomial_expand_coefficients", "linear_system_solution_set", "exact_check_expr", "bounded_enumeration", "real_root_count_expr", "splitting_field_degree_expr", "circle_laplacian_expr", "planar_laplacian_expr", "interpolation_fit_check", "stats_ols_check", "finite_group_structure", "solve_quadratic_diophantine", "symbolic_diophantine_with_timeout", "solve_system_guarded_expr", "polynomial_function_check", "gf2_rank", "gf2_nullspace", "transition_count", "independence_polynomial_chain", "count_by_digit_property", "rook_numbers", "count_avoiding_permutations", "markov_expected_steps", "cover_time_complete_graph", "finite_difference_derivative", "richardson_extrapolate"] },
                  "args": { "type": "object" },
                  "scope": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              },
              "remainingMs": { "type": "integer", "minimum": 26, "maximum": 5000 }
            }
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "receipt", "remainingMs"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effectId", "binding", "status", "source", "observation", "observationHash", "level", "checkResult"],
            "properties": {
              "effectId": { "type": "string", "enum": ["effect-1", "effect-2", "effect-3", "effect-4", "effect-5", "effect-6"] },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sessionId", "problemHash", "contractVersion", "taskId", "scopeId", "sourceRequestId"],
                "properties": {
                  "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "contractVersion": { "type": "integer", "const": 1 },
                  "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "scopeId": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "sourceRequestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] }
                }
              },
              "status": { "type": "string", "enum": ["COMPLETE", "ERROR", "UNKNOWN"] },
              "source": { "type": "string", "const": "PROGRAM_OBSERVATION" },
              "observation": { "type": "string", "minLength": 1, "maxLength": 16000 },
              "observationHash": { "type": "string", "minLength": 64, "maxLength": 64 },
              "level": { "type": "string", "const": "PROVISIONAL" },
              "checkResult": { "type": "string", "const": "UNKNOWN" }
            }
          },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
        }
      }
    },
    "method.catalog": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "remainingMs", "catalog"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
          "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "entries"],
            "properties": {
              "version": { "type": "string", "const": "1.1.0" },
              "entries": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 256 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "method.load": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "request"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effectId", "binding", "action", "remainingMs"],
            "properties": {
              "effectId": { "type": "string", "enum": ["effect-1", "effect-2", "effect-3", "effect-4", "effect-5", "effect-6"] },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sessionId", "problemHash", "contractVersion", "taskId", "scopeId", "sourceRequestId"],
                "properties": {
                  "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "contractVersion": { "type": "integer", "const": 1 },
                  "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "scopeId": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "sourceRequestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] }
                }
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action", "id"],
                "properties": {
                  "action": { "type": "string", "const": "method" },
                  "id": { "type": "string", "minLength": 1, "maxLength": 64 }
                }
              },
              "remainingMs": { "type": "integer", "minimum": 26, "maximum": 5000 }
            }
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "receipt", "remainingMs"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p3-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effectId", "binding", "status", "source", "observation", "observationHash", "level", "checkResult"],
            "properties": {
              "effectId": { "type": "string", "enum": ["effect-1", "effect-2", "effect-3", "effect-4", "effect-5", "effect-6"] },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sessionId", "problemHash", "contractVersion", "taskId", "scopeId", "sourceRequestId"],
                "properties": {
                  "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "contractVersion": { "type": "integer", "const": 1 },
                  "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "scopeId": { "type": "string", "minLength": 64, "maxLength": 64 },
                  "sourceRequestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] }
                }
              },
              "status": { "type": "string", "enum": ["COMPLETE", "ERROR", "UNKNOWN"] },
              "source": { "type": "string", "const": "METHOD_REFERENCE" },
              "observation": { "type": "string", "minLength": 1, "maxLength": 16000 },
              "observationHash": { "type": "string", "minLength": 64, "maxLength": 64 },
              "level": { "type": "string", "const": "PROVISIONAL" },
              "checkResult": { "type": "string", "const": "UNKNOWN" }
            }
          },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
        }
      }
    }
  }
}
