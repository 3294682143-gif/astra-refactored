{
  "format": "astra-p2-host-manifest-v1",
  "schemaDialect": "astra-p0-schema-subset-v1",
  "title": "Astra P2 local Host<->Node protocol manifest",
  "description": "Single normative field specification for the P2 local Host<->Node NDJSON channel. Mock-only local prototype: no real provider, no network, no tool execution. Protocol version is fixed to 1.1-p2-host-local.",
  "protocolVersion": "1.1-p2-host-local",
  "limits": {
    "maxFrameBytes": 65536,
    "maxFramesPerSession": 1024,
    "maxDepth": 24,
    "maxSafeInteger": 9007199254740991,
    "maxIdChars": 128,
    "maxSessionIdChars": 128
  },
  "envelopes": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": { "type": "object" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "result": { "type": "object" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "type": "string", "const": "2.0" },
        "id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "message": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  },
  "methods": {
    "runtime.initialize": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "remainingMs", "maxModelCalls", "maxMethodLoads", "maxTokens", "mode"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "remainingMs": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "maxModelCalls": { "type": "integer", "minimum": 0, "maximum": 3 },
          "maxMethodLoads": { "type": "integer", "minimum": 0, "maximum": 1 },
          "maxTokens": { "type": "integer", "const": 8192 },
          "mode": { "type": "string", "const": "MOCK_ONLY" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "mode", "targetEnvironment"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mode": { "type": "string", "const": "MOCK_ONLY" },
          "targetEnvironment": { "type": "string", "const": "TARGET_UNVERIFIED" }
        }
      }
    },
    "session.solve": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "problem", "problemHash", "methodId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "problem": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "methodId": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "status", "finalResponse", "candidateVerified", "strictAcceptance", "mode", "modelCalls", "methodLoads", "methodStatus", "deliveryStatus", "artifactCount", "openObligations", "contextHash", "candidateRequestId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "type": "string", "enum": ["candidate", "unsolved"] },
          "finalResponse": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "candidateVerified": { "type": "boolean", "const": false },
          "strictAcceptance": { "type": "string", "const": "NOT_PERFORMED" },
          "mode": { "type": "string", "const": "MOCK_ONLY" },
          "modelCalls": { "type": "integer", "minimum": 0, "maximum": 3 },
          "methodLoads": { "type": "integer", "minimum": 0, "maximum": 1 },
          "methodStatus": { "type": "string", "enum": ["NONE", "LOADED", "REFUSED"] },
          "deliveryStatus": { "type": "string", "enum": ["NONE", "COMPLETE", "INCOMPLETE", "TRUNCATED", "ERROR"] },
          "artifactCount": { "type": "integer", "minimum": 0, "maximum": 3 },
          "openObligations": { "type": "integer", "minimum": 1, "maximum": 16 },
          "contextHash": { "type": ["string", "null"], "minLength": 64, "maxLength": 64 },
          "candidateRequestId": { "type": ["string", "null"], "enum": [null, "model-1", "model-2", "model-3"] }
        }
      }
    },
    "model.generate": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "requestId", "problemHash", "contractVersion", "taskId", "scopeId", "contextHash", "maxTokens", "temperature", "messages"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] },
          "problemHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "contractVersion": { "type": "integer", "const": 1 },
          "taskId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "scopeId": { "type": "string", "minLength": 64, "maxLength": 64 },
          "contextHash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "maxTokens": { "type": "integer", "const": 8192 },
          "temperature": { "type": "string", "const": "0.2" },
          "messages": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["system", "user"] },
                "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
              }
            }
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "requestId", "mode", "deliveryStatus", "text", "remainingMs"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "requestId": { "type": "string", "enum": ["model-1", "model-2", "model-3"] },
          "mode": { "type": "string", "const": "MOCK_ONLY" },
          "deliveryStatus": { "type": "string", "enum": ["COMPLETE", "TRUNCATED", "ERROR", "UNKNOWN"] },
          "text": { "type": "string", "maxLength": 12000 },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
        }
      }
    },
    "session.stop": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "stopped"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "stopped": { "type": "boolean", "const": true }
        }
      }
    },
    "method.catalog": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "remainingMs", "catalog"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
          "catalog": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "entries"],
            "properties": {
              "version": { "type": "string", "const": "1.1.0" },
              "entries": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
                    "tasks": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
                    "objects": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
                    "structures": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
                    "role": { "type": "string", "enum": ["method", "decision"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "method.load": {
      "direction": "node-to-host",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "methodId"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "methodId": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocolVersion", "sessionId", "remainingMs", "methodId", "status", "asset"],
        "properties": {
          "protocolVersion": { "type": "string", "const": "1.1-p2-host-local" },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "remainingMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
          "methodId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "status": { "type": "string", "enum": ["loaded", "not_found", "disabled", "integrity_failed"] },
          "asset": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "title", "version", "body", "bodySha256", "bodyChars"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "version": { "type": "string", "const": "1.1.0" },
              "body": { "type": "string", "minLength": 1, "maxLength": 24000 },
              "bodySha256": { "type": "string", "minLength": 64, "maxLength": 64 },
              "bodyChars": { "type": "integer", "minimum": 1, "maximum": 24000 }
            }
          }
        }
      }
    }
  }
}
