{
  "format": "astra-agent-host-manifest-v1",
  "schemaDialect": "astra-p0-schema-subset-v1",
  "title": "Astra unified AgentLoop local Host<->Node protocol manifest",
  "description": "Single normative field specification for the unified AgentLoop local Host<->Node NDJSON channel. Preview profile: explicit engine=ts, no provider access from Node, no arbitrary code; bounded method capabilities are advisory only and never a mathematical obligation.",
  "protocolVersion": "1.3-agent-loop-preview",
  "limits": {
    "maxFrameBytes": 65536,
    "maxFramesPerSession": 64,
    "maxDepth": 24,
    "maxSafeInteger": 9007199254740991,
    "maxIdChars": 128,
    "maxSessionIdChars": 128
  },
  "envelopes": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "params": {
          "type": "object"
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "type": "object"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  },
  "methods": {
    "runtime.initialize": {
      "direction": "host-to-node",
      "kind": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "sessionId",
          "profileId",
          "capabilities",
          "remainingMs",
          "maxModelCalls",
          "maxWorkUnits",
          "maxEffects",
          "maxReviews",
          "policy",
          "maxMethodLoads"
        ],
        "properties": {
          "deriveBudget": {
            "type": "boolean"
          },
          "protocolVersion": {
            "type": "string",
            "const": "1.3-agent-loop-preview"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profileId": {
            "type": "string",
            "const": "math-agent-preview-v2"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelGenerate",
              "toolExecute",
              "methodLoad",
              "generatedPython",
              "maxTokens",
              "maxTokensVerified",
              "journal",
              "requireExplicitFinishForTools"
            ],
            "properties": {
              "modelGenerate": {
                "type": "string",
                "const": "AVAILABLE"
              },
              "toolExecute": {
                "type": "string",
                "enum": [
                  "AVAILABLE",
                  "UNAVAILABLE"
                ]
              },
              "methodLoad": {
                "type": "string",
                "enum": [
                  "AVAILABLE",
                  "UNAVAILABLE"
                ]
              },
              "generatedPython": {
                "type": "string",
                "const": "UNAVAILABLE"
              },
              "maxTokens": {
                "type": "integer",
                "const": 8192
              },
              "maxTokensVerified": {
                "type": "boolean",
                "const": false
              },
              "journal": {
                "type": "string",
                "const": "IN_MEMORY_ONLY"
              },
              "requireExplicitFinishForTools": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "remainingMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "maxModelCalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "maxWorkUnits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "maxEffects": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "maxReviews": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "policy": {
            "type": "string",
            "enum": [
              "BEST_EFFORT",
              "STRICT"
            ]
          },
          "maxMethodLoads": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "maxRepairs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "maxR0": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "sessionId",
          "engine",
          "mode"
        ],
        "properties": {
          "protocolVersion": {
            "type": "string",
            "const": "1.3-agent-loop-preview"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "engine": {
            "type": "string",
            "const": "ts"
          },
          "mode": {
            "type": "string",
            "const": "TS_PREVIEW"
          }
        }
      }
    },
    "session.solve": {
