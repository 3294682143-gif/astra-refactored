{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "domainId",
    "rawText"
  ],
  "properties": {
    "domainId": {
      "const": "math"
    },
    "rawText": {
      "type": "string"
    },
    "profileId": {
      "type": "string",
      "default": "prod"
    },
    "budgets": {
      "maxModelCalls": {
        "type": "integer",
        "default": 5
      },
      "maxToolCalls": {
        "type": "integer",
        "default": 5
      },
      "timeoutMs": {
        "type": "integer",
        "default": 60000
      }
    }
  }
}