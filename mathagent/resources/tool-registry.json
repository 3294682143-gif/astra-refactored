    "exact_check_expr": {
      "family": "symbolic_algebra",
      "skill_status": "implemented",
      "implementation_status": "available",
      "declared_scope": "Bounded exact symbolic checks: trig reduction, maximal minors, factorization over explicit algebraic extensions, definite integrals, limits and density normalization",
      "evidence_type": "independent sympy recomputation under a whitelisted expression AST",
      "required_params": [
        "operation"
      ],
      "optional_params": [
        "expression",
        "variable",
        "matrix",
        "lower",
        "upper",
        "point",
        "minimal_polynomials",
        "density"
      ],
      "input_schema": {
        "operation": "SIMPLIFY|TRIG_REDUCE|MAXIMAL_MINORS|FACTOR_OVER_EXTENSION|DEFINITE_INTEGRAL|LIMIT|DENSITY_CHECK",
        "expression": "bounded scalar expression AST",
        "variable": "short identifier",
        "matrix": "rectangular expression matrix, at most 8x8",
        "lower/upper/point": "expression or oo/-oo",
        "minimal_polynomials": "1..4 univariate polynomials for RootOf extensions",
        "density": "bounded scalar expression"
      },
      "limits": [
        "degree<=12; matrix<=8x8; extensions<=4; no source mapping proof; integration may return unevaluated"
      ],
      "aliases": []
    },
    "bounded_enumeration": {
      "family": "algorithm_simulation",
      "skill_status": "implemented",
      "implementation_status": "available",
      "declared_scope": "Exhaustive count of k-subsets of an explicit finite object table or Cartesian-product universe satisfying a bounded attribute predicate",
      "evidence_type": "complete itertools.combinations enumeration with exact reduced fraction",
      "required_params": [
        "choose",
        "predicate"
      ],
      "optional_params": [
        "objects",
        "ranges"
      ],
      "input_schema": {
        "objects": "optional 1..60 rows, each 1..4 int/string attributes",
        "ranges": "optional 1..4 positive product dimensions; objects are generated as their Cartesian product",
        "choose": "1..6",
        "predicate": "distinct(i), count(i,v), size(), sum(i), min(i), max(i), contains(i,v), arithmetic/comparisons"
      },
      "limits": [
        "at most 5,000,000 combinations; no arbitrary code; mapping from problem to attributes remains model-owned"
      ],
      "aliases": []
    },
